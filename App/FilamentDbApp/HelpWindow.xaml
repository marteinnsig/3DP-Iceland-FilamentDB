<Window x:Class="FilamentDbApp.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="3DPIceland Help" Width="1120" Height="780" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC"
        automation:AutomationProperties.AutomationId="HelpWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="3DPIceland Help" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Workflow guide, tab reference and safe recovery boundaries"
                               Foreground="#CBD5E1" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                         Margin="18,0,0,0" Padding="10,0" TextChanged="SearchBox_TextChanged"
                         automation:AutomationProperties.AutomationId="HelpSearch"
                         ToolTip="Search help topics and content"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CONTENTS" FontWeight="SemiBold" Foreground="#64748B"
                               Margin="18,18,18,10"/>
                    <TreeView x:Name="SectionTree" Margin="10,0,10,12" BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="SectionTree_SelectedItemChanged"
                              automation:AutomationProperties.AutomationId="HelpSections"
                              automation:AutomationProperties.Name="Help contents tree">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Header}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Margin="4,5">
                                    <TextBlock x:Name="NodeHeader" Text="{Binding Header}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="NodeSummary" Text="{Binding Summary}" Foreground="#475569"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                        <Setter TargetName="NodeHeader" Property="Foreground" Value="#475569"/>
                                        <Setter TargetName="NodeHeader" Property="FontSize" Value="12"/>
                                        <Setter TargetName="NodeSummary" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="ContentScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="34,28,42,36">
                    <TextBlock x:Name="CategoryText" Foreground="#64748B" FontWeight="SemiBold"
                               automation:AutomationProperties.AutomationId="HelpSectionCategory"/>
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" Foreground="#0F172A"
                               Margin="0,5,0,8" TextWrapping="Wrap"
                               automation:AutomationProperties.AutomationId="HelpSectionTitle"/>
                    <TextBlock x:Name="SummaryText" FontSize="15" Foreground="#475569" TextWrapping="Wrap"
                               Margin="0,0,0,22"
                               automation:AutomationProperties.AutomationId="HelpSectionSummary"/>
                    <TextBlock x:Name="BodyText" FontSize="14" LineHeight="23" Foreground="#1E293B"
                               TextWrapping="Wrap" automation:AutomationProperties.AutomationId="HelpSectionBody"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <TextBlock x:Name="ResultStatusText" Foreground="#64748B" VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="HelpResultStatus"/>
                <Button DockPanel.Dock="Right" Content="Close" Width="90" Padding="10,5" IsCancel="True"
                        Click="Close_Click" automation:AutomationProperties.AutomationId="CloseHelp"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
