<Window x:Class="FilamentDbApp.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FilamentDbApp"
        Title="3DPIceland Engineering Platform"
        Width="620" Height="390"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="26" Background="#F8FAFC" BorderBrush="#DCE3EC" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.28" Color="#0F172A" />
        </Border.Effect>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Width="210" Height="210" HorizontalAlignment="Center">
                <Border CornerRadius="44" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Image Source="pack://application:,,,/Assets/3dp-iceland-labs-icon.png" Margin="10" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <Rectangle Width="76" Height="58" Margin="0,106,0,0"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Fill="White" IsHitTestVisible="False" />
                <Path x:Name="ExtrusionTrace"
                      Data="M 105,108 C 105,119 101,124 82,124 C 73,124 73,131 82,131 L 128,131 C 139,131 139,142 128,142 L 82,142 C 72,142 72,158 82,158 L 137,158"
                      Stroke="#1479F6" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" StrokeDashArray="52,52" StrokeDashOffset="52"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>

            <TextBlock Grid.Row="1" Text="3DPIceland Engineering Platform"
                       HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="#172131" Margin="0,12,0,0" />
            <TextBlock Grid.Row="2" Text="Filament intelligence, testing and reporting"
                       HorizontalAlignment="Center" FontSize="13" Foreground="#64748B" Margin="0,5,0,0" />
            <Grid Grid.Row="3" Margin="12,20,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LoadingText" Text="Starting platform…" Foreground="#475569" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{x:Static local:BuildInfo.ShortLabel}" Foreground="#64748B" FontSize="12" />
            </Grid>
        </Grid>
    </Border>
</Window>
