<Window x:Class="FilamentDbApp.SafeDeleteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Delete"
        Width="460"
        SizeToContent="Height"
        MinHeight="175"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Segoe UI"
        FontSize="12"
        AutomationProperties.AutomationId="SafeDeleteConfirmationWindow"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0"
                  Width="32"
                  Height="32"
                  Margin="0,0,16,0"
                  VerticalAlignment="Top">
                <Path Data="M16,1 L31,29 L1,29 Z"
                      Fill="#F59E0B"
                      Stroke="#9A6700"
                      StrokeThickness="1"/>
                <TextBlock Text="!"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,5,0,0"/>
            </Grid>
            <TextBlock x:Name="ConfirmationMessage"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       AutomationProperties.AutomationId="SafeDeleteConfirmationMessage"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="ConfirmDeleteButton"
                    Content="Yes"
                    MinWidth="78"
                    Height="28"
                    Padding="10,3"
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="ConfirmSafeDelete"
                    Click="ConfirmDeleteButton_Click"/>
            <Button x:Name="CancelDeleteButton"
                    Content="No"
                    MinWidth="78"
                    Height="28"
                    Padding="10,3"
                    IsDefault="True"
                    IsCancel="True"
                    AutomationProperties.AutomationId="CancelSafeDelete"
                    Click="CancelDeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
