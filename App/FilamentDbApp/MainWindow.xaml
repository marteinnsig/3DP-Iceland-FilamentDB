                                <WrapPanel>
                                    <Button Click="RefreshReportPreview_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8" FontWeight="SemiBold"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE72C;"/><TextBlock Text="Refresh Preview"/></StackPanel></Button>
