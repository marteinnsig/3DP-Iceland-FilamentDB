                            <Button Grid.Row="0" Grid.Column="5" Click="OpenReportOutputFolder_Click" Style="{StaticResource IconActionButton}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE838;"/><TextBlock Text="Open Folder"/></StackPanel></Button>

