                                            <DataGrid x:Name="AnalyticsResultsList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0" BorderThickness="1" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="AnalyticsResultsList_SelectionChanged">
