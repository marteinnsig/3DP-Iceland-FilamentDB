                            <Button Grid.Row="2" Grid.Column="4" Click="OpenWebsiteExportFolder_Click" Style="{StaticResource IconActionButton}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE838;"/><TextBlock Text="Open Folder"/></StackPanel></Button>
