                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rankings Dashboard" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="Top material rankings from the currently visible dataset. Uses the same scoring profile as the analytics/recommendation engine: Overall, Tensile, Impact, Stiffness, Consistency, and Layer Adhesion." Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="RankingSummaryText" Text="Rankings use the current visible Materials scope." Foreground="#2563EB" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
