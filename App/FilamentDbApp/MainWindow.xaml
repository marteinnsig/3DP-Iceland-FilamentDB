                                        <ComboBoxItem Content="Overall" />
                                        <ComboBoxItem Content="Tensile" />
                                        <ComboBoxItem Content="Impact" />
                                        <ComboBoxItem Content="Stiffness" />
                                        <ComboBoxItem Content="Consistency" />
                                        <ComboBoxItem Content="Layer Adhesion" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Base material" FontWeight="SemiBold" Foreground="#334155" />
                                    <ComboBox x:Name="RankingBaseMaterialFilter" SelectionChanged="RankingFilter_Changed" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="Manufacturer" FontWeight="SemiBold" Foreground="#334155" />
                                    <ComboBox x:Name="RankingManufacturerFilter" SelectionChanged="RankingFilter_Changed" />
