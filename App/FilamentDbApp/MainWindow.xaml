                                    <Button x:Name="ExportEngineeringReportPackageButton" Click="ExportEngineeringReportPackage_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8" FontWeight="SemiBold" ToolTip="Export all six accepted engineering reports with canonical HTML and PDF into one indexed package."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE7B8;"/><TextBlock Text="Export Engineering Package"/></StackPanel></Button>
                                    <Button x:Name="BuildPublicMaterialReportPreviewButton" Click="BuildPublicMaterialReportPreview_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8" FontWeight="SemiBold" ToolTip="Build allowlisted Material Engineering HTML/PDF previews for every active MaterialID checked Public reports. Report template and Report scope do not control this public batch action. This does not upload anything."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE774;"/><TextBlock Text="Build Public Material Reports"/></StackPanel></Button>
                                    <Button x:Name="BuildPublicComparisonReportPreviewButton" Click="BuildPublicComparisonReportPreview_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8" FontWeight="SemiBold" ToolTip="Build local public Material Family comparison presets from explicitly allowlisted MaterialIDs. This does not upload anything."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE8EF;"/><TextBlock Text="Build Public Comparisons"/></StackPanel></Button>
                                    <Button x:Name="BuildPublicManufacturerReportPreviewButton" Click="BuildPublicManufacturerReportPreview_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8" FontWeight="SemiBold" ToolTip="Build local public manufacturer portfolio reports from explicitly allowlisted MaterialIDs. This does not upload anything."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE77B;"/><TextBlock Text="Build Public Manufacturers"/></StackPanel></Button>
                                    <Button x:Name="BuildPublicTestSessionReportPreviewButton" Click="BuildPublicTestSessionReportPreview_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8" FontWeight="SemiBold" ToolTip="Build public Test Session reports; raw inputs and notes require the separate Public test details approval. This does not upload anything."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE9D9;"/><TextBlock Text="Build Public Test Sessions"/></StackPanel></Button>
                                    <Button x:Name="BuildPublicPrintingRecommendationPreviewButton" Click="BuildPublicPrintingRecommendationPreview_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8" FontWeight="SemiBold" ToolTip="Build full public Printing Recommendation reports from governed profiles. This does not upload anything."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE8D4;"/><TextBlock Text="Build Public Recommendations"/></StackPanel></Button>
                                    <Button x:Name="BuildPublicMaterialSummaryPreviewButton" Click="BuildPublicMaterialSummaryPreview_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8" FontWeight="SemiBold" ToolTip="Build the public REPORT-110 dataset summary from explicitly allowlisted MaterialIDs. This does not upload anything."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE9D2;"/><TextBlock Text="Build Public Material Summary"/></StackPanel></Button>
                                    <Button x:Name="BuildPublicEngineeringReportPackageButton"
                                            AutomationProperties.AutomationId="BuildPublicReportPackage"
                                            Click="BuildPublicEngineeringReportPackage_Click" Style="{StaticResource IconActionButton}"
                                            Margin="0,0,8,8" FontWeight="SemiBold"
                                            ToolTip="Build any missing public reports, verify all six report types and create the canonical portfolio index, manifest and catalog. This does not upload anything."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE7B8;"/><TextBlock Text="Build Public Report Package"/></StackPanel></Button>
                                </WrapPanel>
                                <TextBlock Text="Report template and scope control Refresh Preview and Export Current Report. Each public build button names its own report family and uses opted-in public materials." Foreground="#64748B" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="12" Background="White" BorderBrush="#D7DBE3" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
