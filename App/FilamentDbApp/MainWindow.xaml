<Window x:Class="FilamentDbApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:FilamentDbApp"
        xmlns:controls="clr-namespace:FilamentDbApp.Controls"
        Title="3DPIceland Engineering Platform - Filament Database" Height="960" Width="1700" MinHeight="760" MinWidth="1280"
        AutomationProperties.AutomationId="MainWindow" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="DarkBrush" Color="#111827" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D7DBE3" />
        <local:TensileSampleValueBrushConverter x:Key="TensileSampleValueBrushConverter" />
        <local:ImpactSampleValueBrushConverter x:Key="ImpactSampleValueBrushConverter" />
        <!-- UI-001: shared control rhythm and tooltip timing. Local margins remain in layout panels. -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="450" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="450" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="450" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <EventSetter Event="GotKeyboardFocus" Handler="TextBox_GotKeyboardFocus" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <!-- Keep the selected page stretched to the available workspace.
                 Centering VerticalContentAlignment here centers the entire TabItem page,
                 which creates a large blank area above short/filtered views. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- v37.9: recycle only the rows/cells visible in the viewport.
             This avoids constructing hundreds of off-screen rows and dozens of
             off-screen columns while scrolling the large editor grids. -->
        <Style x:Key="HighPerformanceDataGrid" TargetType="DataGrid">
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.CacheLength" Value="1,1" />
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
        </Style>
        <Style TargetType="StatusBarItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- UI-002: lightweight Segoe MDL2 glyphs for high-value action buttons only. -->
        <Style x:Key="ActionIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="18" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="IconActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="TensileSpacerCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="TensileSampleCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text, Converter={StaticResource TensileSampleValueBrushConverter}}" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style x:Key="ImpactSampleCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text, Converter={StaticResource ImpactSampleValueBrushConverter}}" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style x:Key="TensileComputedCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <DataTemplate x:Key="ComparisonValueCellTemplate">
            <Border Padding="4,2" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                <Setter Property="Background" Value="#DCFCE7" />
                                <Setter Property="BorderBrush" Value="#86EFAC" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Display}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#0F172A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#14532D" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Background="#EEF1F5">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File" AutomationProperties.AutomationId="FileMenu">
                <MenuItem Header="Backup and Recovery Center..." Click="ShowRecoveryCenter_Click"
                          AutomationProperties.AutomationId="OpenRecoveryCenter" />
                <Separator />
                <MenuItem Header="Choose Storage Folder..." Click="ChooseStorageFolder_Click"
                          AutomationProperties.AutomationId="ChooseStorageFolder" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Materials">
                <MenuItem Header="Add Material" Click="AddNativeMaterial_Click" />
                <MenuItem Header="Duplicate Material" Click="DuplicateNativeMaterial_Click" />
                <Separator />
                <MenuItem Header="Archive Material" Click="ArchiveNativeMaterial_Click" />
                <MenuItem Header="Unarchive Material" Click="UnarchiveNativeMaterial_Click" />
                <MenuItem Header="Delete Material" Click="DeleteNativeMaterial_Click" />
                <Separator />
                <MenuItem Header="Clear Search" Click="ClearSearch_Click" />
                <MenuItem Header="Clear Filters" Click="ClearNativeMaterialFilters_Click" />
            </MenuItem>
            <MenuItem Header="_Website" AutomationProperties.AutomationId="WebsiteMenu">
                <MenuItem Header="Open Website Export" Click="OpenWebsiteExportTab_Click"
                          AutomationProperties.AutomationId="OpenWebsiteExportTab" />
            </MenuItem>
            <MenuItem Header="_Tools" AutomationProperties.AutomationId="ToolsMenu">
                <MenuItem Header="Validate Materials" Click="ValidateNativeMaterials_Click" />
                <MenuItem Header="Rebuild Computed Fields" Click="RebuildNativeMaterialDisplayNames_Click" />
                <MenuItem Header="Materials Rendering Prototype..." Click="ShowMaterialsRenderingPrototype_Click" />
                <MenuItem Header="Update Readiness..." Click="UpdateReadiness_Click"
                          AutomationProperties.AutomationId="UpdateReadiness" />
                <MenuItem Header="Check for Updates..." Click="CheckForUpdates_Click"
                          AutomationProperties.AutomationId="CheckForUpdates" />
                <MenuItem Header="Publish Application Release..." Click="PublishApplicationRelease_Click"
                          AutomationProperties.AutomationId="PublishApplicationRelease" />
                <MenuItem Header="Publish Application Update..." Click="PublishApplicationUpdate_Click"
                          AutomationProperties.AutomationId="PublishApplicationUpdate" />
                <MenuItem Header="Open Storage Folder" Click="OpenStorageFolder_Click"
                          AutomationProperties.AutomationId="OpenStorageFolder" />
            </MenuItem>
            <MenuItem Header="_Help" AutomationProperties.AutomationId="HelpMenu">
                <MenuItem Header="Documentation" AutomationProperties.AutomationId="OpenHelp"
                          Click="Documentation_Click" />
                <MenuItem Header="Help for Current View" AutomationProperties.AutomationId="OpenContextHelp"
                          InputGestureText="F1" Click="ContextHelp_Click" />
                <MenuItem Header="Export Engineering Whitepaper..." Click="ExportEngineeringWhitepaper_Click" />
                <MenuItem Header="Changelog" Click="Changelog_Click" />
                <Separator />
                <MenuItem Header="Verification Center" AutomationProperties.AutomationId="OpenVerificationCenter"
                          Click="VerificationCenter_Click" />
                <MenuItem Header="System Diagnostics" Click="SystemDiagnostics_Click"
                          AutomationProperties.AutomationId="OpenSystemDiagnostics" />
                <MenuItem Header="About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Padding="18" Background="{StaticResource DarkBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="180" Height="96" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="18" Padding="8" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/3dp-iceland-labs-header-logo.png"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="3DPIceland Engineering Platform" Foreground="White" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static local:BuildInfo.MainHeaderText}" Foreground="#CBD5E1" FontSize="14" Margin="0,4,0,0" />
                    <TextBlock x:Name="RuntimeProfileIdentityText" AutomationProperties.AutomationId="RuntimeProfileIdentity"
                               Foreground="#86EFAC" FontSize="13" FontWeight="Bold" Margin="0,5,0,0" />
                    <StackPanel x:Name="AutomationCrudPanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <Button AutomationProperties.AutomationId="AutomationCrudCreate" Content="Automation CRUD: Create"
                                Click="AutomationCrudCreate_Click" Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationCrudEdit" Content="Edit"
                                Click="AutomationCrudEdit_Click" Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationCrudDelete" Content="Delete"
                                Click="AutomationCrudDelete_Click" Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationCrudVerifyAbsent" Content="Verify absent"
                                Click="AutomationCrudVerifyAbsent_Click" Margin="0,0,6,0" />
                        <TextBlock x:Name="AutomationCrudStatusText" AutomationProperties.AutomationId="AutomationCrudStatus"
                                   Foreground="#F8FAFC" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="AutomationRecoveryPanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <Button AutomationProperties.AutomationId="AutomationRecoveryBackup" Content="Recovery: Backup + Catalog"
                                Click="AutomationRecoveryBackup_Click" Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationRecoveryExportExcel" Content="Export Excel"
                                Click="AutomationRecoveryExportExcel_Click" Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationRecoveryMutate" Content="Mutate"
                                Click="AutomationRecoveryMutate_Click" Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationRecoveryRestoreExcel" Content="Restore Excel"
                                Click="AutomationRecoveryRestoreExcel_Click" Margin="0,0,6,0" />
                        <TextBlock x:Name="AutomationRecoveryStatusText"
                                   AutomationProperties.AutomationId="AutomationRecoveryStatus"
                                   Foreground="#F8FAFC" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="AutomationLandedCostPanel" Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="Collapsed">
                        <Button AutomationProperties.AutomationId="AutomationLandedCostPrepare"
                                Content="Landed cost: Prepare" Click="AutomationLandedCostPrepare_Click"
                                Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationLandedCostOverride"
                                Content="Override" Click="AutomationLandedCostOverride_Click"
                                Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationLandedCostCalculate"
                                Content="Calculate" Click="AutomationLandedCostCalculate_Click"
                                Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationLandedCostDownstream"
                                Content="Downstream" Click="AutomationLandedCostDownstream_Click"
                                Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationLandedCostCleanup"
                                Content="Cleanup" Click="AutomationLandedCostCleanup_Click"
                                Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="AutomationLandedCostVerifyAbsent"
                                Content="Verify absent" Click="AutomationLandedCostVerifyAbsent_Click"
                                Margin="0,0,6,0" />
                        <TextBlock x:Name="AutomationLandedCostStatusText"
                                   AutomationProperties.AutomationId="AutomationLandedCostStatus"
                                   Foreground="#F8FAFC" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="#1F2937" CornerRadius="6" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderSummaryText" Text="No data loaded" Foreground="#E5E7EB" FontSize="13" />
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="12,8" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="ApplicationStatus" VerticalAlignment="Center"
                               Text="Ready." TextTrimming="CharacterEllipsis" Foreground="#334155" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Materials → Verification → Calculations → Website Export"
                           VerticalAlignment="Center" Foreground="#64748B" Margin="18,0,0,0" />
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,1,1,0">
            <StatusBarItem>
                <TextBlock x:Name="FooterText" Text="Storage: not loaded" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="AutoSaveStatusText" Text="Auto-save: ready" FontWeight="SemiBold" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="LastSavedText" Text="Last saved: —" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="NativeCountStatusText" Text="Native workflow" />
            </StatusBarItem>
        </StatusBar>


        <TabControl Margin="14" x:Name="WorkspaceTabs" AutomationProperties.AutomationId="WorkspaceTabs"
                    SelectionChanged="WorkspaceTabs_SelectionChanged"><TabItem Header="Materials" AutomationProperties.AutomationId="MaterialsTab">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Materials"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Manage native material records, pricing, purchase details and website metadata. Archived materials remain available here but are excluded from active exports."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="NativeMaterialValidationHelpText"
                                   Text="Validation checks required row identity: Material ID, Manufacturer, Product Line, Base Material and computed Website Display Name. OK means all are present."
                                   Foreground="#475569"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Name="SaveNativeMaterialsButton" Click="SaveNativeMaterials_Click" Style="{StaticResource IconActionButton}" Margin="0,0,16,8" IsEnabled="False"
                                ToolTip="Create a manual SQLite backup now."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE74E;"/><TextBlock Text="Manual Backup"/></StackPanel></Button>
                        <Button Click="AddNativeMaterial_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8"
                                ><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE710;"/><TextBlock Text="Add Material"/></StackPanel></Button>
                        <Button Click="DuplicateNativeMaterial_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8"
                                ToolTip="Create a new material from the selected material."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE8C8;"/><TextBlock Text="Duplicate"/></StackPanel></Button>
                        <Button Click="ArchiveNativeMaterial_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8"
                                ToolTip="Hide the selected material from active lists and exports without deleting it."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE7B8;"/><TextBlock Text="Archive"/></StackPanel></Button>
                        <Button Click="UnarchiveNativeMaterial_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,8"
                                ToolTip="Return the selected archived material to active lists and exports."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE777;"/><TextBlock Text="Unarchive"/></StackPanel></Button>
                        <Button Click="DeleteNativeMaterial_Click" Style="{StaticResource IconActionButton}" Margin="0,0,16,8"
                                ToolTip="Permanently delete the selected material and its measurement rows."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE74D;"/><TextBlock Text="Delete"/></StackPanel></Button>
                        <Button Content="Reset Columns" Click="ResetFastMaterialsColumns_Click" Padding="10,4" Margin="0,0,16,8"/>
                        <TextBlock Name="NativeMaterialSummaryText" Text="Materials load from canonical SQLite storage." VerticalAlignment="Center" Foreground="#64748B" Margin="8,0,0,8"/>
                        <TextBlock Name="NativeMaterialCountText" Text="0 materials" VerticalAlignment="Center" Foreground="#2563EB" FontWeight="SemiBold" Margin="14,0,0,8"/>
                        <TextBlock Name="NativeMaterialSelectionText" Text="Selected MaterialID: none" VerticalAlignment="Center" Foreground="#1E3A8A" FontWeight="SemiBold" Margin="14,0,0,8"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Filters:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Text="Search materials" VerticalAlignment="Center" Margin="0,0,4,8"/>
                        <TextBox Name="NativeMaterialSearchBox" Width="220"
                                 AutomationProperties.AutomationId="NativeMaterialSearch"
                                 TextChanged="NativeMaterialFilter_Changed"
                                 KeyDown="NativeMaterialSearchBox_KeyDown"
                                 TabIndex="0" Margin="0,0,12,8"
/>
                        <controls:MaterialFacetFilterControl
                            x:Name="NativeMaterialManufacturerMultiFilter"
                            FilterLabel="Manufacturer" Width="235" Margin="0,0,12,8"
                            AutomationProperties.AutomationId="NativeMaterialManufacturerMultiFilter"
                            SelectionChanged="NativeMaterialFacetFilter_Changed"/>
                        <controls:MaterialFacetFilterControl
                            x:Name="NativeMaterialBaseMaterialMultiFilter"
                            FilterLabel="Base Material" Width="220" Margin="0,0,12,8"
                            AutomationProperties.AutomationId="NativeMaterialBaseMaterialMultiFilter"
                            SelectionChanged="NativeMaterialFacetFilter_Changed"/>
                        <TextBlock Name="NativeMaterialBaseMaterialLinkStatusText"
                                   AutomationProperties.AutomationId="NativeMaterialBaseMaterialLinkStatus"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="#B45309" Margin="0,0,12,8"/>
                        <controls:MaterialFacetFilterControl
                            x:Name="NativeMaterialVariantFinishMultiFilter"
                            FilterLabel="Variant / Finish" Width="220" Margin="0,0,12,8"
                            AutomationProperties.AutomationId="NativeMaterialVariantFinishMultiFilter"
                            SelectionChanged="NativeMaterialFacetFilter_Changed"/>
                        <controls:MaterialFacetFilterControl
                            x:Name="NativeMaterialReinforcementMultiFilter"
                            FilterLabel="Reinforcement" Width="220" Margin="0,0,12,8"
                            AutomationProperties.AutomationId="NativeMaterialReinforcementMultiFilter"
                            SelectionChanged="NativeMaterialFacetFilter_Changed"/>
                        <controls:MaterialFacetFilterControl
                            x:Name="NativeMaterialColorMultiFilter"
                            FilterLabel="Color" Width="200" Margin="0,0,12,8"
                            AutomationProperties.AutomationId="NativeMaterialColorMultiFilter"
                            SelectionChanged="NativeMaterialFacetFilter_Changed"/>
                        <controls:MaterialFacetFilterControl
                            x:Name="NativeMaterialProductLineMultiFilter"
                            FilterLabel="Product Line" Width="220" Margin="0,0,12,8"
                            AutomationProperties.AutomationId="NativeMaterialProductLineMultiFilter"
                            SelectionChanged="NativeMaterialFacetFilter_Changed"/>
                        <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,4,8"/>
                        <ComboBox Name="NativeMaterialCategoryFilter" Width="145" TabIndex="7"
                                  AutomationProperties.AutomationId="NativeMaterialCategoryFilter"
                                  SelectionChanged="NativeMaterialFilter_Changed" Margin="0,0,12,8"
/>
                        <TextBlock Text="Test status" VerticalAlignment="Center" Margin="0,0,4,8"/>
                        <ComboBox Name="NativeMaterialTestedFilter" Width="135" TabIndex="8"
                                  AutomationProperties.AutomationId="NativeMaterialTestedFilter"
                                  SelectionChanged="NativeMaterialFilter_Changed" Margin="0,0,12,8"
/>
                        <Button Click="ClearNativeMaterialFilters_Click" TabIndex="9"
                                AutomationProperties.AutomationId="ClearNativeMaterialFilters"
                                Style="{StaticResource IconActionButton}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ActionIcon}" Text="&#xE894;"/>
                                <TextBlock Text="Clear All Filters"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <GroupBox Grid.Row="3" Header="Materials - source of truth for native modules">
                        <Grid>
                            <ContentControl Name="FastMaterialsViewHost" AutomationProperties.AutomationId="FastMaterialsViewHost"
                                            Visibility="Collapsed" Margin="8"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
<TabItem Header="Manufacturers" AutomationProperties.AutomationId="ManufacturersTab">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Add Manufacturer" Click="AddManufacturer_Click" Padding="10,5" Margin="0,0,8,0"/>
            <Button Content="Duplicate" Click="DuplicateManufacturer_Click" Padding="10,5" Margin="0,0,8,0"/>
            <Button x:Name="BindExactMaterialManufacturerNamesButton"
                    Content="Bind Exact Material Names" Click="BindExactMaterialManufacturerNames_Click"
                    AutomationProperties.AutomationId="BindExactMaterialManufacturerNames"
                    Padding="10,5" Margin="0,0,8,0"/>
            <Button Content="Archive / Restore" Click="ToggleManufacturerActive_Click" Padding="10,5" Margin="0,0,8,0"/>
            <Button Content="Delete" Click="DeleteManufacturer_Click" Padding="10,5" Margin="0,0,16,0"/>
            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ManufacturerSearchBox" Width="240" TextChanged="ManufacturerSearchBox_TextChanged"/>
