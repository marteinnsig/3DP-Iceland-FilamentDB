                                <Button Click="GenerateWebsiteProductionExport_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,0" FontWeight="SemiBold" ToolTip="Automatically ensure public reports, then replace index.html after confirmation; the current file is backed up first."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ActionIcon}" Text="&#xE898;"/><TextBlock Text="Generate Production"/></StackPanel></Button>
