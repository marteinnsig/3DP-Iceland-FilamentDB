<Window x:Class="FilamentDbApp.DocumentBrandingPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Branding Preview"
        Width="760"
        Height="480"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Segoe UI"
        FontSize="12"
        AutomationProperties.AutomationId="DocumentBrandingPreviewWindow"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Generated-document logo preview"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"/>
            <TextBlock x:Name="PreviewStatusText"
                       AutomationProperties.AutomationId="DocumentBrandingPreviewStatus"
                       Margin="0,4,0,0"
                       Foreground="#475569"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="24"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4">
            <Image x:Name="PreviewImage"
                   AutomationProperties.AutomationId="DocumentBrandingPreviewLargeImage"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"/>
        </Border>

        <Button x:Name="ClosePreviewButton"
                Grid.Row="2"
                Content="Close"
                AutomationProperties.AutomationId="CloseDocumentBrandingPreview"
                MinWidth="88"
                Height="30"
                Padding="12,4"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="ClosePreviewButton_Click"/>
    </Grid>
</Window>
